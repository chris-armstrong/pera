# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Pera agent core loop"
description: "Agent loop, hooks, and tool execution"
maintainer: ["oss@chrisarmstrong.dev"]
authors: ["Chris Armstrong"]
homepage: "https://github.com/chris-armstrong/pera"
bug-reports: "https://github.com/chris-armstrong/pera/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.4"}
  "pera-types" {= version}
  "pera-provider" {= version}
  "containers" {>= "3.0"}
  "yojson" {>= "2.0"}
  "eio" {>= "1.0"}
  "eio_main" {>= "1.0"}
  "eio_linux" {>= "1.0"}
  "logs" {>= "0.7"}
  "re" {>= "1.10"}
  "ppx_deriving" {>= "1.6"}
  "qcheck-core" {>= "0.21" & with-test}
  "qcheck-alcotest" {>= "0.21" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/chris-armstrong/pera.git"
