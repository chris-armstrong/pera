#!/usr/bin/env bash
# pre-commit hook: check formatting of staged OCaml files
#
# INSTALLATION (manual — git hooks are not committed):
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#
# This script must be installed manually after cloning the repository.
# It is not automatically active.

set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ml|mli)$' || true)

if [ -z "$staged_files" ]; then
  exit 0
fi

failed=0

for file in $staged_files; do
  if ! ocamlformat --check "$file" 2>/dev/null; then
    echo "ocamlformat: formatting check failed: $file" >&2
    failed=1
  fi
done

if [ "$failed" -eq 1 ]; then
  echo "" >&2
  echo "Run 'ocamlformat --inplace <file>' to fix formatting issues." >&2
  exit 1
fi

exit 0
