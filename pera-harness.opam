opam-version: "2.0"
synopsis: "Session logging infrastructure for Pera"
description:
  "Entry ID generation, session type definitions, JSONL writer, and agent wrapper for the Pera AI agent framework"
maintainer: ["carmstrong@fastmail.com.au"]
authors: ["Chris Armstrong"]
homepage: "https://github.com/chris-armstrong/pera"
bug-reports: "https://github.com/chris-armstrong/pera/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.4"}
