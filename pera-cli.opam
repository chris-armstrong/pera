# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Reusable CLI wiring for Pera"
description:
  "CLI argument parsing, config loading, and session management for the Pera AI agent framework"
maintainer: ["carmstrong@fastmail.com.au"]
authors: ["Chris Armstrong"]
homepage: "https://github.com/chris-armstrong/pera"
bug-reports: "https://github.com/chris-armstrong/pera/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.4"}
  "pera-types" {= version}
  "pera-connector" {= version}
  "pera-core" {= version}
  "pera-env" {= version}
  "pera-harness" {= version}
  "pera-tools" {= version}
  "pera-agent" {= version}
  "containers" {>= "3.0"}
  "sexplib" {>= "0.17"}
  "ppx_sexp_conv" {>= "0.17"}
  "xdg" {>= "3.0"}
  "cmdliner" {>= "1.2"}
  "uuidm" {>= "0.9"}
  "yojson" {>= "2.0"}
  "fpath" {>= "0.7"}
  "re" {>= "1.0"}
  "cstruct" {>= "6.0"}
  "eio" {>= "1.0"}
  "eio_main" {>= "1.0"}
  "eio_linux" {>= "1.0"}
  "alcotest" {>= "1.7" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/chris-armstrong/pera.git"
