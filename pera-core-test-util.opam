# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Test utilities for pera-core"
description: "Test doubles and Alcotest testables for pera-core consumers"
maintainer: ["oss@chrisarmstrong.dev"]
authors: ["Chris Armstrong"]
homepage: "https://github.com/chris-armstrong/pera"
bug-reports: "https://github.com/chris-armstrong/pera/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.4"}
  "pera-types" {= version}
  "pera-provider" {= version}
  "pera-core" {= version}
  "containers" {>= "3.0"}
  "yojson" {>= "2.0"}
  "eio" {>= "1.0"}
  "eio_main" {>= "1.0"}
  "alcotest" {>= "1.7"}
  "ppx_deriving" {>= "1.6"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/chris-armstrong/pera.git"
